{
  "name": "TEDDY X ULTRA",
  "description": "WhatsApp Bot powered by Bailey's and built by teddy Tech Hub",
  "repository": "https://github.com/Teddyxmd/TEDDY-XMD",
  "build": {
    "builder": "DOCKERFILE",
    "buildCommand": "npm install"
  },
  "deploy": {
    "startCommand": "node index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "variables": {
    "SESSION_ID": {
      "description": "REQUIRED: TEDDY-XMD~.... Session token",
      "required": true
    },
    "REPO_URL": {
      "description": "Optional: override the bot source zip URL the loader downloads at startup",
      "required": false
    }
  }
}
